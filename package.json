{
  "name": "truyen-audio-chatbot-mcp",
  "version": "1.2.1",
  "description": "MCP Server tư vấn và gợi ý truyện cho Chatbot AI (endpoint /chatbot/* backend Laravel)",
  "main": "dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "bin": {
    "truyen-audio-chatbot-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --format=esm --banner:js=\"#!/usr/bin/env node\" --outfile=dist/index.js --minify",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "node --import tsx --test"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "truyen-audio",
    "chatbot",
    "ai-agent"
  ],
  "author": "Quoc Hung",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/comics-fly/chatbot-truyenseo-audio-mcp-nodejs.git"
  },
  "bugs": {
    "url": "https://github.com/comics-fly/chatbot-truyenseo-audio-mcp-nodejs/issues"
  },
  "homepage": "https://github.com/comics-fly/chatbot-truyenseo-audio-mcp-nodejs#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
